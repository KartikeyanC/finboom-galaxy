{
  "name": "FinRoot — Wealth OS",
  "short_name": "FinRoot",
  "description": "The calm, intelligent wealth OS for households — income, expenses, investments, budgets and goals in one place.",
  "id": "/",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "en",
  "background_color": "#0B231C",
  "theme_color": "#0B231C",
  "categories": ["finance", "productivity"],
  "shortcuts": [
    {
      "name": "Quick Add Expense",
      "short_name": "Add Expense",
      "description": "Instantly record an expense",
      "url": "/app?quick-add=1&source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quick Add Income",
      "short_name": "Add Income",
      "description": "Instantly record income",
      "url": "/app?quick-add=1&source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
