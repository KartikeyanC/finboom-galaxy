# Copy this file to `.env.e2e` and fill in a TEST account's credentials.
# `.env.e2e` is gitignored so secrets never get committed.
#
# Run the E2E suite with:  npm run e2e
# (Authenticated tests are skipped automatically if E2E_EMAIL is missing.)

E2E_BASE_URL=http://localhost:8080
E2E_EMAIL=your-test-account@example.com
E2E_PASSWORD=your-test-password
E2E_PIN=3210
